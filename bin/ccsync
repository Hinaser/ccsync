#!/bin/sh
# ccsync - move Claude Code sessions between machines.
#
# Dependencies: POSIX utilities; the Tailscale CLI for Taildrop only.
set -u

# Received bundles carry transcripts: keep everything this script writes private.
umask 077

SELF_DIR=${0%/*}
[ "$SELF_DIR" = "$0" ] && SELF_DIR=.
VERSION=$(awk -F'"' '/"version"[[:space:]]*:/ { print $4; exit }' \
    "$SELF_DIR/../.claude-plugin/plugin.json" 2>/dev/null)
: "${VERSION:=unknown}"

CLAUDE_HOME=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
PROJECTS=$CLAUDE_HOME/projects
FILE_HISTORY=$CLAUDE_HOME/file-history
STATE=$CLAUDE_HOME/ccsync
MAP=$STATE/map
ARCHIVE=$STATE/archive
CONFLICTS=$STATE/conflicts
OUTBOX=$STATE/outbox
MAX_HISTORY_KB=65536
MAX_BUNDLE_KB=65536       # refuse an incoming bundle larger than this
MAX_UNPACKED_KB=262144    # and one that expands past this

QUIET=0
AUTO=0
TRANSPORT=${CCSYNC_TRANSPORT:-tailscale}
SHARE=${CCSYNC_SHARE:-}
FS_HOST=${CCSYNC_HOST:-}

die() {
    printf 'ccsync: %s\n' "$*" >&2
    exit 1
}
say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }

# ------------------------------------------------------------------ platform

is_wsl() {
    [ -r /proc/sys/kernel/osrelease ] || return 1
    case $(cat /proc/sys/kernel/osrelease 2>/dev/null) in
        *icrosoft*) return 0 ;;
        *) return 1 ;;
    esac
}

IS_WSL=0
is_wsl && IS_WSL=1

IS_WINDOWS=0
case $(uname -s) in MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;; esac

TS_BIN=
TS_CROSS=0     # a Windows binary driven from WSL: its arguments must be Windows paths

find_tailscale() {
    [ -n "$TS_BIN" ] && return 0
    for c in \
        "${CCSYNC_TAILSCALE:-}" \
        "$( [ "$IS_WSL" = 1 ] && printf '%s' '/mnt/c/Program Files/Tailscale/tailscale.exe' )" \
        "$(command -v tailscale 2>/dev/null)" \
        '/Applications/Tailscale.app/Contents/MacOS/Tailscale' \
        '/usr/local/bin/tailscale' \
        '/opt/homebrew/bin/tailscale' \
        '/usr/bin/tailscale' \
        '/c/Program Files/Tailscale/tailscale.exe' \
        'C:/Program Files/Tailscale/tailscale.exe'
    do
        [ -n "$c" ] && [ -x "$c" ] && { TS_BIN=$c; break; }
        [ -n "$c" ] && [ -f "$c" ] && { TS_BIN=$c; break; }
    done
    [ -n "$TS_BIN" ] || die "tailscale not found. Install Tailscale; on WSL keep the Windows client (no separate WSL install needed). Override with CCSYNC_TAILSCALE."
    case $TS_BIN in
        *.exe) [ "$IS_WSL" = 1 ] && TS_CROSS=1 ;;
    esac
    return 0
}

ts() {
    find_tailscale
    if [ "$TS_CROSS" = 1 ]; then
        ( cd /mnt/c 2>/dev/null || cd /; "$TS_BIN" "$@" )
    else
        "$TS_BIN" "$@"
    fi
}

# Render a local path the way the tailscale binary expects it.
arg_path() {
    find_tailscale
    if [ "$TS_CROSS" = 1 ]; then
        wslpath -w "$1"
    else
        printf '%s' "$1"
    fi
}

# ---------------------------------------------------------------- primitives

# A manifest field that becomes a path component or a filename. Rejecting '/'
# and '..' outright is what keeps a peer from steering rm -rf or a transcript
# write outside the directory we mean to touch.
safe_component() { # value
    case ${1:-} in
        ''|.|..)            return 1 ;;
        -*)                 return 1 ;;
        *[!A-Za-z0-9._-]*)  return 1 ;;
    esac
    return 0
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf ''
    fi
}

now_iso() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

# Claude Code's project-directory key: non-alphanumerics become '-'.
encode_project() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

# Resolve ~/.claude/projects/<key>. Prefer an existing directory matched
# loosely so we never depend on guessing the exact escaping rule.
project_dir() {
    _cwd=$1
    _direct=$PROJECTS/$(encode_project "$_cwd")
    if [ -d "$_direct" ]; then printf '%s' "$_direct"; return 0; fi
    _key=$(printf '%s' "$_cwd" | sed 's/[^A-Za-z0-9]//g' | tr 'A-Z' 'a-z')
    if [ -d "$PROJECTS" ]; then
        for d in "$PROJECTS"/*; do
            [ -d "$d" ] || continue
            _n=$(basename "$d" | sed 's/[^A-Za-z0-9]//g' | tr 'A-Z' 'a-z')
            [ "$_n" = "$_key" ] && { printf '%s' "$d"; return 0; }
        done
    fi
    printf '%s' "$_direct"
}

# Normalize Windows spellings without treating a WSL /mnt/c path as Windows.
normalize_path() {
    printf '%s' "$1" | awk '
        {s=$0; if(s ~ /^[A-Za-z]:/ || s ~ /^\\\\/) {
            gsub(/\\/, "/", s)
            if(s ~ /^[A-Za-z]:/) s=toupper(substr(s,1,1)) substr(s,2)
        }
        while(length(s)>1 && s ~ /\/$/ && s !~ /^[A-Za-z]:\/$/) s=substr(s,1,length(s)-1)
        printf "%s",s}'
}

abs_path() (
    [ -n "$1" ] || return 0
    if [ "$IS_WINDOWS" = 1 ] && command -v cygpath >/dev/null 2>&1; then
        normalize_path "$(cygpath -am "$1")"
    else
        if [ -d "$1" ]; then
            (cd "$1" && pwd)
            return
        fi
        case $1 in
            /*|[A-Za-z]:*|\\\\*) normalize_path "$1" ;;
            *) normalize_path "$PWD/$1" ;;
        esac
    fi
)

transcript_cwd() {
    if [ "$IS_WINDOWS" = 1 ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -aw "$1"
    else
        printf '%s' "$1"
    fi
}

# GNU tar treats a colon in -f as a remote host; use a Git Bash path for
# archive filenames while retaining canonical/native paths elsewhere.
archive_path() {
    if [ "$IS_WINDOWS" = 1 ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -au "$1"
    else
        printf '%s' "$1"
    fi
}

# ---------------------------------------------------------------- state file
# Tab-separated records:
#   local <key> <value>
#   path  <host> <local-cwd> <remote-cwd>
#   host  <host> <field> <value>

# State holds transcripts and received bundles: 0700 even on an install that
# predates the umask above.
private_dir() { mkdir -p "$1" && chmod 700 "$1" 2>/dev/null || :; }

map_init() { private_dir "$STATE"; [ -f "$MAP" ] || : > "$MAP"; }

map_set() ( # kind key... value  (replaces any record with the same leading fields)
    for field in "$@"; do valid_field "$field" || die "tabs and newlines are not supported in configuration fields"; done
    if [ "$1" = path ]; then
        set -- "$1" "$2" "$(abs_path "$3")" "$(normalize_path "$4")"
    fi
    map_init
    _n=$#
    _val=$(eval printf '%s' "\"\${$_n}\"")
    _keys=
    _i=1
    while [ "$_i" -lt "$_n" ]; do
        _keys=$_keys$(eval printf '%s' "\"\${$_i}\"")$(printf '\t')
        _i=$((_i + 1))
    done
    _tmp=$(mktemp "$STATE/.map.XXXXXXXXXX") || return 1
    CCSYNC_PATH_WINDOWS=$IS_WINDOWS CCSYNC_MAP_KEYS=$_keys awk -F'\t' -v n="$((_n - 1))" "$PATH_AWK"'
        BEGIN {split(ENVIRON["CCSYNC_MAP_KEYS"],keys,"\t")}
        $1=="path" && keys[1]=="path" && $2==keys[2] && pathkey($3,1)==pathkey(keys[3],1) {next}
        { pre = ""; for (i = 1; i <= n; i++) pre = pre $i "\t" }
        pre != ENVIRON["CCSYNC_MAP_KEYS"] { print }
    ' "$MAP" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    printf '%s%s\n' "$_keys" "$_val" >> "$_tmp"
    mv "$_tmp" "$MAP"
)

map_get() { # kind key...
    [ -f "$MAP" ] || return 1
    _n=$#
    _keys=
    _i=1
    while [ "$_i" -le "$_n" ]; do
        _keys=$_keys$(eval printf '%s' "\"\${$_i}\"")$(printf '\t')
        _i=$((_i + 1))
    done
    CCSYNC_MAP_KEYS=$_keys awk -F'\t' -v n="$_n" '
        { pre = ""; for (i = 1; i <= n; i++) pre = pre $i "\t" }
        pre == ENVIRON["CCSYNC_MAP_KEYS"] { print $(n + 1); exit }
    ' "$MAP"
}

map_del() ( # kind key...  (removes every record with the same leading fields)
    [ -f "$MAP" ] || return 0
    _n=$#
    _keys=
    _i=1
    while [ "$_i" -le "$_n" ]; do
        _keys=$_keys$(eval printf '%s' "\"\${$_i}\"")$(printf '\t')
        _i=$((_i + 1))
    done
    _tmp=$(mktemp "$STATE/.map.XXXXXXXXXX") || return 1
    CCSYNC_MAP_KEYS=$_keys awk -F'\t' -v n="$_n" '
        { pre = ""; for (i = 1; i <= n; i++) pre = pre $i "\t" }
        pre != ENVIRON["CCSYNC_MAP_KEYS"] { print }
    ' "$MAP" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$MAP"
)

# Map keys use forward slashes on Windows; transcripts use native Windows cwd.
# Environment values avoid awk -v interpreting backslashes in user paths.
PATH_AWK='
function pathkey(s, islocal) {
    if(s ~ /^[A-Za-z]:/ || s ~ /^\\\\/) gsub(/\\/, "/", s)
    if(islocal && ENVIRON["CCSYNC_PATH_WINDOWS"]==1 && s ~ /^\/[A-Za-z](\/|$)/)
        s=substr(s,2,1) ":" substr(s,3)
    while(length(s)>1 && s ~ /\/$/ && s !~ /^[A-Za-z]:\/$/) s=substr(s,1,length(s)-1)
    if(s ~ /^[A-Za-z]:/ || s ~ /^\/\//) s=tolower(s)
    return s
}'

map_remote_for() {
    [ -f "$MAP" ] || return 1
    CCSYNC_PATH_WINDOWS=$IS_WINDOWS CCSYNC_LOOKUP_HOST=$1 CCSYNC_LOOKUP_PATH=$2 awk -F '\t' "$PATH_AWK"'
        $1=="path" && tolower($2)==tolower(ENVIRON["CCSYNC_LOOKUP_HOST"]) &&
        pathkey($3,1)==pathkey(ENVIRON["CCSYNC_LOOKUP_PATH"],1) {print $4; exit}' "$MAP"
}

map_local_for() {
    [ -f "$MAP" ] || return 1
    CCSYNC_PATH_WINDOWS=$IS_WINDOWS CCSYNC_LOOKUP_HOST=$1 CCSYNC_LOOKUP_PATH=$2 awk -F '\t' "$PATH_AWK"'
        $1=="path" && pathkey($4,0)==pathkey(ENVIRON["CCSYNC_LOOKUP_PATH"],0) {
            if(tolower($2)==tolower(ENVIRON["CCSYNC_LOOKUP_HOST"])) {print $3; found=1; exit}
            if(alt=="") alt=$3
        } END {if(!found && alt!="") print alt}' "$MAP"
}

map_hosts() {
    [ -f "$MAP" ] || return 0
    awk -F'\t' '$1 == "path" || $1 == "host" { print $2 }' "$MAP" | sort -u
}

# ---------------------------------------------------------------- configuration

load_config() {
    DEFAULT_TRANSPORT=$(map_get local transport); : "${DEFAULT_TRANSPORT:=tailscale}"
    DEFAULT_SHARE=$(map_get local share)
    FS_HOST=${CCSYNC_HOST:-$(map_get local host)}
    TRANSPORT=${CCSYNC_TRANSPORT:-$DEFAULT_TRANSPORT}
    SHARE=${CCSYNC_SHARE:-$DEFAULT_SHARE}
    [ -z "$SHARE" ] || SHARE=$(abs_path "$SHARE")
    OPT_TRANSPORT=; OPT_SHARE=
    RECEIVE_ROUTE=0
}

need_value() {
    [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value; see ccsync help"
    case $2 in --* ) die "$1 requires a value; see ccsync help" ;; esac
}

valid_field() {
    case $1 in *"	"*|*"
"*|*"$(printf '\r')"*) return 1 ;; esac
}

configured_shares() {
    {
        [ -z "$SHARE" ] || printf '%s\n' "$SHARE"
        if [ -f "$MAP" ]; then
            awk -F '\t' '$1=="share" && $3=="enabled" && $4==1 {print $2}
                         $1=="host" && $3=="share" {print $4}' "$MAP"
        fi
    } | CCSYNC_PATH_WINDOWS=$IS_WINDOWS awk "$PATH_AWK"'
        !seen[pathkey($0,1)]++ {print}' | sort
}

filesystem_peers() ( # optional share; includes legacy inboxes
    root=${1:-$SHARE}
    for entry in "$root"/*; do
        [ -d "$entry" ] && [ ! -L "$entry" ] || continue
        name=${entry##*/}
        safe_component "$name" || continue
        printf '%s\n' "$name"
    done
)

filesystem_peer() ( # resolve case to the receiver's published name
    want=$1
    filesystem_peers | awk -v want="$want" 'tolower($0)==tolower(want) {name=$0; n++} END {if(n==1) print name}'
)

register_inbox() ( # Only create our own inbox, never a destination's.
    transport_ready
    for name in $(filesystem_peers); do
        if [ "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$FS_HOST" | tr 'A-Z' 'a-z')" ] && [ "$name" != "$FS_HOST" ]; then
            die "endpoint name conflicts with '$name' on $SHARE; choose a distinct --host"
        fi
    done
    inbox=$SHARE/$FS_HOST
    [ ! -L "$inbox" ] || die "inbox is a symlink: $inbox"
    mkdir -p "$inbox" || die "cannot create inbox $inbox; check share permissions"
    # Persist an identity so another configuration cannot claim this name.
    identity=$(map_get local endpoint_id)
    if [ -z "$identity" ]; then
        private_dir "$STATE"
        unique=$(mktemp "$STATE/.endpoint.XXXXXXXXXX") || die "cannot create endpoint identity"
        identity=${unique##*.}; rm -f "$unique"
        map_set local endpoint_id "$identity" || die "cannot save endpoint identity"
    fi
    marker=$inbox/.ccsync-peer
    if [ -e "$marker" ]; then
        [ "$(cat "$marker")" = "$identity" ] || die "'$FS_HOST' is registered by another endpoint on $SHARE; choose a unique --host"
    else
        # noclobber prevents two first-time setups from claiming the same name.
        (set -C; printf '%s\n' "$identity" > "$marker") 2>/dev/null || die "cannot register $inbox; check permissions or retry setup"
    fi
)

saved_peer_name() {
    map_hosts | awk -v want="$1" '
        $0==want {exact=$0}
        tolower($0)==tolower(want) {name=$0; n++}
        END {if(exact!="") print exact; else if(n==1) print name}'
}

select_transport() { # peer; command flags > environment > saved peer > discovery/default
    _lookup_peer=$(saved_peer_name "$1"); _lookup_peer=${_lookup_peer:-$1}
    TRANSPORT=${OPT_TRANSPORT:-${CCSYNC_TRANSPORT:-$(map_get host "$_lookup_peer" transport)}}
    SHARE=${OPT_SHARE:-${CCSYNC_SHARE:-$(map_get host "$_lookup_peer" share)}}
    [ -z "$SHARE" ] || SHARE=$(abs_path "$SHARE")
    if [ -z "$TRANSPORT" ]; then
        # Existing pre-transport mappings are Taildrop mappings.
        if [ -n "$(map_get host "$_lookup_peer" os)" ] || [ -n "$(map_remote_for "$_lookup_peer" "${_local:-$PWD}")" ]; then
            TRANSPORT=tailscale
            [ "$(map_get host "$_lookup_peer" os)" != filesystem ] || TRANSPORT=filesystem
        else
            SHARE=${SHARE:-$DEFAULT_SHARE}
            _matches=$(configured_shares | while IFS= read -r root; do
                (SHARE=$root; [ -z "$(filesystem_peer "$1")" ] || printf '%s\n' "$root")
            done)
            _count=$(printf '%s\n' "$_matches" | awk 'NF {n++} END {print n+0}')
            [ "$_count" -le 1 ] || die "'$1' exists on multiple shares; select one with --share <dir>"
            if [ "$_count" = 1 ]; then TRANSPORT=filesystem; SHARE=$_matches; fi
        fi
    fi
    TRANSPORT=${TRANSPORT:-$DEFAULT_TRANSPORT}
    SHARE=${SHARE:-$DEFAULT_SHARE}
    transport_ready
    if [ "$TRANSPORT" = filesystem ]; then
        safe_component "$1" || die "invalid filesystem peer name: $1"
        register_inbox || return 1
        _hn=$(filesystem_peer "$1")
        [ -n "$_hn" ] || die "no filesystem peer '$1' on $SHARE. Known peers: $(filesystem_peers | tr '\n' ' '). Run ccsync setup --share <dir> --host <name> on the receiver, then ccsync status here."
        [ "$_hn" != "$FS_HOST" ] || die "'$1' is this endpoint; choose a different peer from ccsync status"
        [ "$_hn" = "$1" ] || say "  using receiver's registered name: $_hn"
    else
        _hn=$(peer_field "$1" hostname)
        [ -n "$_hn" ] || die "'$1' is not in this tailnet; check tailscale status, or use --share <dir> for a filesystem peer"
    fi
}

remember_transport() ( # peer; temporary environment overrides do not replace an existing route
    if [ -n "$(map_get host "$1" transport)" ] &&
       [ -z "$OPT_TRANSPORT$OPT_SHARE" ] && [ -n "${CCSYNC_TRANSPORT:-}${CCSYNC_SHARE:-}" ]; then
        return 0
    fi
    map_set host "$1" transport "$TRANSPORT" || return 1
    if [ "$TRANSPORT" = filesystem ]; then
        map_set host "$1" share "$SHARE"
        map_set share "$SHARE" enabled 1
    else
        map_del host "$1" share
    fi
)

remember_received_transport() (
    [ "$RECEIVE_ROUTE" = 1 ] || return 0
    OPT_TRANSPORT=$TRANSPORT
    remember_transport "$1"
)

receive_routes() {
    {
        configured_shares | while IFS= read -r root; do
            [ -z "$root" ] || printf 'filesystem\t%s\n' "$root"
        done
        if [ "$TRANSPORT" = tailscale ] || [ "$(map_get local tailscale)" = enabled ] ||
           { [ -f "$MAP" ] && awk -F '\t' '
               $1=="path" {peers[$2]=1}
               $1=="host" && $3=="transport" {route[$2]=$4}
               END {for(p in route) if(route[p]=="tailscale") exit 0
                    for(p in peers) if(!(p in route)) exit 0; exit 1}' "$MAP"; }; then
            printf 'tailscale\t-\n'
        fi
    } | sort -u
}

cmd_setup() {
    setup_transport=; setup_share=; setup_host=; remove_share=
    while [ $# -gt 0 ]; do
        case $1 in
            --share) need_value "$@"; setup_share=$2; shift 2 ;;
            --host) need_value "$@"; setup_host=$2; shift 2 ;;
            --transport) need_value "$@"; setup_transport=$2; shift 2 ;;
            --remove-share) need_value "$@"; remove_share=$2; shift 2 ;;
            *) die "unknown setup option: $1; see ccsync help" ;;
        esac
    done
    if [ -n "$remove_share" ]; then
        [ -z "$setup_transport$setup_share$setup_host" ] || die "use --remove-share on its own"
        remove_share=$(abs_path "$remove_share")
        if [ -f "$MAP" ] && awk -F '\t' -v s="$remove_share" '$1=="host" && $3=="share" && $4==s {found=1} END {exit !found}' "$MAP"; then
            die "share is used by saved peers; run ccsync unmap <peer> for those peers first (see ccsync status)"
        fi
        map_del share "$remove_share"
        if [ "$(map_get local share)" = "$remove_share" ]; then
            map_del local share
            map_set local transport tailscale
        fi
        say "removed share from configuration: $remove_share (files preserved)"
        return
    fi
    [ -z "$setup_share" ] || setup_transport=${setup_transport:-filesystem}
    TRANSPORT=${setup_transport:-$TRANSPORT}
    case $TRANSPORT in tailscale|filesystem) ;; *) die "unknown transport: $TRANSPORT (use tailscale or filesystem)" ;; esac
    if [ "$TRANSPORT" = filesystem ]; then
        SHARE=$(abs_path "${setup_share:-$SHARE}")
        FS_HOST=${setup_host:-$FS_HOST}
        if [ -z "$FS_HOST" ]; then
            FS_HOST=$(hostname | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._-]/-/g')
            if [ "$IS_WSL" = 1 ]; then
                FS_HOST=$FS_HOST-$(printf '%s' "${WSL_DISTRO_NAME:-wsl}" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._-]/-/g')
            fi
        fi
        _old_host=$(map_get local host)
        if [ -n "$_old_host" ] && [ "$_old_host" != "$FS_HOST" ]; then
            die "endpoint name is already '$_old_host'; keep it stable or use a separate CLAUDE_CONFIG_DIR for a new endpoint"
        fi
        register_inbox || return 1
        map_set local host "$FS_HOST"
        map_set local share "$SHARE"
        map_set share "$SHARE" enabled 1
        say "registered endpoint: $FS_HOST"
        say "shared directory: $SHARE"
        say "inbox: $SHARE/$FS_HOST"
    else
        [ -z "$setup_share$setup_host" ] || die "--share and --host apply to filesystem transport"
        transport_ready
        map_set local tailscale enabled
    fi
    for peer in $(map_hosts); do
        if [ -z "$(map_get host "$peer" transport)" ]; then
            map_set host "$peer" transport "${CCSYNC_TRANSPORT:-$DEFAULT_TRANSPORT}"
            if [ "${CCSYNC_TRANSPORT:-$DEFAULT_TRANSPORT}" = filesystem ]; then
                map_set host "$peer" share "${CCSYNC_SHARE:-$DEFAULT_SHARE}"
            fi
        fi
    done
    map_set local transport "$TRANSPORT"
    say "saved in $MAP; commands and automatic pulls use this configuration"
    say "next: run ccsync setup on the other endpoint, then ccsync status and ccsync init <peer> <remote-dir>"
    [ -z "${CCSYNC_TRANSPORT:-}${CCSYNC_SHARE:-}${CCSYNC_HOST:-}" ] || say "note: CCSYNC_* environment overrides are active; unset them to use only saved configuration"
}

# ------------------------------------------------------------------ tailnet
# `tailscale status` lines look like:
#   100.64.0.1  desktop  user@  macOS  -
#   100.64.0.2  laptop   user@  linux  offline, last seen 1d ago

ts_status_cache=

ts_status() {
    [ -n "$ts_status_cache" ] || ts_status_cache=$(ts status 2>/dev/null)
    printf '%s\n' "$ts_status_cache"
}

self_host() {
    if [ "$TRANSPORT" = filesystem ]; then
        printf '%s\n' "$FS_HOST"
        return
    fi
    ts_status | awk 'NF >= 2 && $1 ~ /^[0-9]+\./ { print $2; exit }'
}

peer_field() { # name field(hostname|ip|os|state)
    if [ "$TRANSPORT" = filesystem ]; then
        safe_component "$1" || return 1
        case $2 in
            hostname) printf '%s\n' "$1" ;;
            state) [ -d "$SHARE/$1" ] && printf 'available\n' || printf 'unavailable\n' ;;
            os) printf 'filesystem\n' ;;
        esac
        return
    fi
    ts_status | awk -v want="$1" -v field="$2" '
        NF >= 2 && $1 ~ /^[0-9]+\./ {
            host = $2
            lw = tolower(want); lh = tolower(host)
            if (lh != lw && $1 != want) next
            state = "online"
            for (i = 3; i <= NF; i++) if (tolower($i) ~ /^offline/) state = "offline"
            if (field == "hostname") print host
            else if (field == "ip") print $1
            else if (field == "os") print $4
            else if (field == "state") print state
            exit
        }'
}

# ------------------------------------------------------------------ staging

transport_ready() {
    case $TRANSPORT in
        tailscale) find_tailscale ;;
        filesystem)
            valid_field "$SHARE" || die "share paths cannot contain tabs or newlines"
            safe_component "$FS_HOST" || die "set a valid endpoint name with ccsync setup --share <dir> --host <name> (letters, digits, dot, underscore or hyphen)"
            case $SHARE in
                /*|[A-Za-z]:/*) ;;
                *) die "configure a shared directory with ccsync setup --share <absolute-dir> --host <name>" ;;
            esac
            [ -d "$SHARE" ] || die "shared directory unavailable: $SHARE; mount it or check the path with ccsync status"
            ;;
        *) die "unknown transport: $TRANSPORT (use tailscale or filesystem)" ;;
    esac
}

send_bundle() ( # bundle peer; subshell keeps caller variables intact
    if [ "$TRANSPORT" = tailscale ]; then
        ts file cp "$(arg_path "$1")" "$2:"
        exit $?
    fi
    safe_component "$2" || exit 1
    _inbox=$SHARE/$2
    [ -d "$_inbox" ] && [ ! -L "$_inbox" ] || { warn "receiver inbox unavailable: $_inbox; run setup on the receiver"; exit 1; }
    # Copy to a unique temporary name on the destination filesystem, then
    # rename there. Interrupted copies never match list_bundles.
    _pending=$(mktemp "$_inbox/.ccsync.XXXXXXXXXX") || exit 1
    trap 'rm -f "$_pending"' EXIT HUP INT TERM
    cp "$1" "$_pending" || exit 1
    _name=$(basename "$1" .tar.gz)
    mv "$_pending" "$_inbox/${_name}_${_pending##*.}.tar.gz"
)

win_temp_dir() {
    _c=/mnt/c/Windows/System32/cmd.exe
    if [ -x "$_c" ]; then
        _w=$( cd /mnt/c && "$_c" /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r' )
        case $_w in
            *%*|'') ;;
            *) _u=$(wslpath -u "$_w" 2>/dev/null)
               [ -n "$_u" ] && [ -d "$_u" ] && { printf '%s' "$_u/Temp"; return 0; } ;;
        esac
    fi
    if [ -d /mnt/c/Users ]; then
        _me=$(printf '%s' "${USER:-${USERNAME:-}}" | tr 'A-Z' 'a-z')
        for u in /mnt/c/Users/*; do
            [ -d "$u" ] || continue
            _n=$(basename "$u" | tr 'A-Z' 'a-z')
            [ "$_n" = "$_me" ] && { printf '%s' "$u/AppData/Local/Temp"; return 0; }
        done
    fi
    [ -d /mnt/c/Windows/Temp ] && { printf '%s' /mnt/c/Windows/Temp; return 0; }
    die "could not locate a Windows temp directory for Taildrop staging"
}

staging_dir() {
    if [ "$TRANSPORT" = filesystem ]; then
        private_dir "$OUTBOX"; printf '%s' "$OUTBOX"; return 0
    fi
    find_tailscale
    if [ "$TS_CROSS" = 0 ]; then
        private_dir "$OUTBOX"; printf '%s' "$OUTBOX"; return 0
    fi
    _cached=$(map_get local win_staging 2>/dev/null)
    if [ -n "$_cached" ] && [ -d "$_cached" ]; then printf '%s' "$_cached"; return 0; fi
    _d=$(win_temp_dir)/ccsync
    mkdir -p "$_d" || die "cannot create staging dir $_d"
    map_set local win_staging "$_d"
    printf '%s' "$_d"
}

# Where a GUI client may auto-accept received files.
auto_accept_dirs() {
    [ -d "$HOME/Downloads" ] && printf '%s\n' "$HOME/Downloads"
    if [ "$IS_WSL" = 1 ]; then
        _s=$(map_get local win_staging 2>/dev/null)
        if [ -n "$_s" ]; then
            _p=$(dirname "$(dirname "$(dirname "$(dirname "$_s")")")")
            [ -d "$_p/Downloads" ] && printf '%s\n' "$_p/Downloads"
        fi
    fi
}

# ---------------------------------------------------------------- transcript

# Identity of each transcript line, independent of the working directory.
# Transcripts are append-only, so comparing these tells us whether one copy is
# a continuation of the other or whether the two have diverged.
chain() { # file cwd
    CCSYNC_CHAIN_CWD=$(json_escape_path "$2") awk '
        BEGIN {cwd=ENVIRON["CCSYNC_CHAIN_CWD"]}
        function repl(s, from, to,   out, p) {
            if (from == "") return s
            out = ""
            while ((p = index(s, from)) > 0) {
                out = out substr(s, 1, p - 1) to
                s = substr(s, p + length(from))
            }
            return out s
        }
        { line = $0
          if (line ~ /^[ \t]*$/) next
          k = index(line, "\"uuid\":\"")
          if (k > 0) {
              rest = substr(line, k + 8)
              e = index(rest, "\"")
              if (e > 1) { print substr(rest, 1, e - 1); next }
          }
          gsub(/\t/, " ", line)
          print "raw:" repl(line, cwd, "\001")
        }' "$1"
}

# 'same' | 'fast-forward' | 'behind' | 'diverged'
compare_chains() { # local-tokens incoming-tokens
    _ln=$(wc -l < "$1"); _in=$(wc -l < "$2")
    if cmp -s "$1" "$2"; then printf 'same'; return 0; fi
    if [ "$_ln" -lt "$_in" ]; then
        head -n "$_ln" "$2" | cmp -s - "$1" && { printf 'fast-forward'; return 0; }
    elif [ "$_in" -lt "$_ln" ]; then
        head -n "$_in" "$1" | cmp -s - "$2" && { printf 'behind'; return 0; }
    fi
    printf 'diverged'
}

common_prefix_len() { # a b
    awk 'NR==FNR { a[FNR] = $0; n = FNR; next }
         { if (FNR > n || a[FNR] != $0) { print FNR - 1; found = 1; exit } }
         END { if (!found) print (FNR < n ? FNR : n) }' "$1" "$2"
}

# JSON string escaping of a path: backslashes are doubled in the transcript.
json_escape_path() {
    printf '%s' "$1" | awk 'BEGIN {ORS=""} {for(i=1;i<=length($0);i++) {
        c=substr($0,i,1); if(c=="\\" || c=="\"") printf "\\"; printf "%s",c
    }}'
}

rewrite_jsonl() { # src dst origin_cwd local_cwd rewrite_all
    CCSYNC_FROM=$3 CCSYNC_TO=$4 CCSYNC_OUT=$2 CCSYNC_ALL=$5 awk '
        function escape(s,  i,c,r) {
            r=""; for(i=1;i<=length(s);i++) {
                c=substr(s,i,1); if(c=="\\" || c=="\"") r=r "\\"; r=r c
            } return r
        }
        function decode(s,  i,c,r) {
            r=""; for(i=1;i<=length(s);i++) {
                c=substr(s,i,1)
                if(c=="\\" && i<length(s)) {i++; c=substr(s,i,1)}
                r=r c
            } return r
        }
        function key(s) {
            if(s ~ /^[A-Za-z]:/) {gsub(/\\/,"/",s); s=tolower(s)}
            if(fromwin && s ~ /^\/[A-Za-z]\//) s=tolower(substr(s,2,1) ":" substr(s,3))
            while(length(s)>1 && s ~ /\/$/ && s !~ /^[A-Za-z]:\/$/) s=substr(s,1,length(s)-1)
            return s
        }
        function repl(s,f,t,  o,p) {
            if(f=="") return s
            o=""; while((p=index(s,f))>0) {o=o substr(s,1,p-1) t; s=substr(s,p+length(f))}
            return o s
        }
        BEGIN {
            from=ENVIRON["CCSYNC_FROM"]; to=ENVIRON["CCSYNC_TO"]
            fromwin=(from ~ /^[A-Za-z]:/); fk=key(from)
            ef=escape(from); et=escape(to); out=ENVIRON["CCSYNC_OUT"]
        }
        {
            lines++; original=$0; result=""; rest=$0
            if(ENVIRON["CCSYNC_ALL"]==1) {
                rest=repl(rest,ef,et)
            } else {
                while(match(rest,/"cwd"[ \t]*:[ \t]*"([^"\\]|\\.)*"/)) {
                    prefix=substr(rest,1,RSTART-1); field=substr(rest,RSTART,RLENGTH)
                    rest=substr(rest,RSTART+RLENGTH)
                    match(field,/:[ \t]*"/); start=RSTART+RLENGTH
                    value=substr(field,start,length(field)-start)
                    if(key(decode(value))==fk) field=substr(field,1,start-1) et "\""
                    result=result prefix field
                }
            }
            result=result rest; if(result!=original) changed++
            print result > out
        }
        END {printf "%d %d\n",lines,changed}
    ' "$1"
}

first_prompt() { # file
    awk '
        /"type":"user"/ {
            k = index($0, "\"content\":\"")
            if (k == 0) next
            s = substr($0, k + 11)
            e = index(s, "\"")
            if (e < 2) next
            t = substr(s, 1, e - 1)
            if (substr(t, 1, 1) == "<") next
            if (length(t) > 60) t = substr(t, 1, 60)
            print t; exit
        }' "$1"
}

session_id_of() { b=$(basename "$1"); printf '%s' "${b%.jsonl}"; }

newest_session() { # cwd
    _d=$(project_dir "$1")
    [ -d "$_d" ] || return 1
    _best=; _bt=0
    for f in "$_d"/*.jsonl; do
        [ -f "$f" ] || continue
        _t=$(mtime_of "$f")
        [ "$_t" -gt "$_bt" ] && { _bt=$_t; _best=$f; }
    done
    [ -n "$_best" ] || return 1
    printf '%s' "$_best"
}

mtime_of() {
    _m=$(date -r "$1" '+%s' 2>/dev/null) || _m=
    [ -n "$_m" ] || _m=$(stat -c %Y "$1" 2>/dev/null) || _m=0
    printf '%s' "${_m:-0}"
}

# ------------------------------------------------------------------ manifest

mf_get() { awk -F'\t' -v k="$2" '$1 == k { sub(/^[^\t]*\t/, ""); print; exit }' "$1"; }
mf_put() { printf '%s\t%s\n' "$1" "$2"; }

# ------------------------------------------------------------------ commands

usage() {
    cat <<'EOF'
ccsync - move Claude Code sessions between machines

  ccsync setup --share <dir> [--host <name>]
  ccsync setup --transport tailscale
  ccsync setup --remove-share <dir>
  ccsync push [-r] [host[:<remote-dir>]] [--session <id>] [--no-history]
              [--transport tailscale|filesystem] [--share <dir>]
  ccsync pull [<local-dir>] [--source <dir>] [--force]
             [--rewrite-all] [--quiet] [--auto]
  ccsync init <host> <remote-dir> [--local <dir>]
              [--transport tailscale|filesystem] [--share <dir>]
  ccsync unmap <host> [<local-dir>]
  ccsync list [--limit N]
  ccsync status
  ccsync --version

For a shared filesystem, run setup on both endpoints first. Status lists peers.
Setup persists settings for commands and the SessionStart hook; no shell exports needed.
A pushed session carries its destination. Use pull <local-dir> to place it elsewhere.
Use -r to include the whole current project: ccsync push -r host:/path/to/project
Push sends a bundle; pull imports it on the receiving machine.
Tailscale is the default. --share selects filesystem transport and remembers it
for that peer; --transport tailscale selects Taildrop. Pull checks every configured inbox.
Push precedence: command flags > CCSYNC_* environment > saved peer > default.
CCSYNC_TRANSPORT, CCSYNC_SHARE and CCSYNC_HOST remain optional environment overrides.
Pull accepts only a local destination, not host:/path. SessionStart runs pull automatically.
EOF
}

cmd_init() {
    _host=; _remote=; _local=$PWD
    while [ $# -gt 0 ]; do
        case $1 in
            --local) need_value "$@"; _local=$2; shift 2 ;;
            --transport) need_value "$@"; OPT_TRANSPORT=$2; shift 2 ;;
            --share) need_value "$@"; OPT_SHARE=$(abs_path "$2"); shift 2 ;;
            -*) die "unknown init option: $1" ;;
            *) if [ -z "$_host" ]; then _host=$1
               elif [ -z "$_remote" ]; then _remote=$1
               else die "expected ccsync init <host> <remote-dir>"; fi
               shift ;;
        esac
    done
    [ -n "$_host" ] && [ -n "$_remote" ] || { usage; return 1; }
    [ -z "$OPT_SHARE" ] || OPT_TRANSPORT=${OPT_TRANSPORT:-filesystem}
    [ -z "$OPT_SHARE" ] || [ "$OPT_TRANSPORT" = filesystem ] || die "--share requires filesystem transport"
    _local=$(abs_path "$_local")
    _remote=$(normalize_path "$_remote")
    select_transport "$_host" || return 1
    _st=$(peer_field "$_hn" state)
    map_set path "$_hn" "$_local" "$_remote"
    map_set host "$_hn" os "$(peer_field "$_hn" os)"
    remember_transport "$_hn"
    say "mapped $_local -> $_hn:$_remote [$TRANSPORT, $_st]"
    if [ "$TRANSPORT" = tailscale ] && [ "$_st" != online ]; then
        say "peer is offline; mapping saved. Bring it online and re-run init to verify."
        return 0
    fi
    _stg=$(staging_dir)
    _tmp=$(mktemp -d) || die "mktemp failed"
    _probe_id=${_tmp##*/}
    {
        mf_put kind probe
        mf_put tool_version "$VERSION"
        mf_put created_at "$(now_iso)"
        mf_put origin_host "$(self_host)"
        mf_put origin_cwd "$_local"
        mf_put claimed_remote_cwd "$_remote"
        mf_put target_host "$_hn"
        mf_put probe_id "$_probe_id"
    } > "$_tmp/manifest"
    _b=$_stg/probe_$(self_host)_$(date '+%s')_$$.tar.gz
    ( cd "$_tmp" && tar -czf "$(archive_path "$_b")" manifest ) || { rm -rf "$_tmp"; die "could not build probe"; }
    rm -rf "$_tmp"
    map_set host "$_hn" probe_id "$_probe_id"
    if ! _err=$(send_bundle "$_b" "$_hn" 2>&1); then
        rm -f "$_b"; die "$TRANSPORT probe to $_hn failed: $_err"
    fi
    rm -f "$_b"
    say "probe sent -> $_hn; run ccsync pull there, then here to receive its acknowledgement"
}

cmd_unmap() {
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "usage: ccsync unmap <host> [<local-dir>]"
    _host=$(saved_peer_name "$1"); _host=${_host:-$1}; _dir=${2:-}
    [ -f "$MAP" ] || die "no mappings recorded"
    if [ -n "$_dir" ]; then
        _dir=$(abs_path "$_dir")
        _matched=$(CCSYNC_PATH_WINDOWS=$IS_WINDOWS CCSYNC_LOOKUP_PATH=$_dir awk -F '\t' -v h="$_host" "$PATH_AWK"'
            $1=="path" && $2==h && pathkey($3,1)==pathkey(ENVIRON["CCSYNC_LOOKUP_PATH"],1) {print $3}' "$MAP")
        [ -n "$_matched" ] || die "$_host has no mapping for $_dir"
        printf '%s\n' "$_matched" | while IFS= read -r path; do map_del path "$_host" "$path"; done
        say "unmapped $_host: $_dir"
    else
        _found=$(awk -F '\t' -v h="$_host" '($1=="path" || $1=="host") && $2==h {print 1; exit}' "$MAP")
        [ -n "$_found" ] || die "no saved peer named $_host; see ccsync status"
        map_del path "$_host"
        map_del host "$_host"
        say "forgot peer: $_host"
    fi
}

# Copy a selected project path into staging. Subshells keep recursive variables
# separate in POSIX sh. Reject links (including ancestor links) and special files.
stage_project_path() (
    root=$1; dest=$2; rel=$3
    case $rel in
        ''|/*|*\\*|[A-Za-z]:*|../*|*/../*|*/..|..) return 1 ;;
    esac
    case $rel in
        *"
"*|*"	"*) return 1 ;;
    esac
    probe=$root
    rest=$rel
    while :; do
        part=${rest%%/*}
        probe=$probe/$part
        [ ! -L "$probe" ] || return 1
        case $rest in */*) rest=${rest#*/} ;; *) break ;; esac
    done
    src=$root/$rel
    if [ -d "$src" ]; then
        mkdir -p "$dest/$rel" || return 1
        for entry in "$src"/* "$src"/.[!.]* "$src"/..?*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            stage_project_path "$root" "$dest" "$rel/${entry##*/}" || return 1
        done
    elif [ -f "$src" ]; then
        mkdir -p "$(dirname "$dest/$rel")" && cp -p "$src" "$dest/$rel" || return 1
    else
        return 1
    fi
)

# Check the whole tree before adding anything. Never replace a differing file,
# a symlink, or a file/directory collision, even when transcript --force is used.
merge_project_tree() (
    src=$1; dest=$2; mode=$3
    [ ! -L "$src" ] && [ ! -L "$dest" ] || {
        warn "  project conflict: symlink at $dest"; return 1;
    }
    if [ -d "$src" ]; then
        if [ -e "$dest" ] && [ ! -d "$dest" ]; then
            warn "  project conflict: $dest is not a directory"; return 1
        fi
        [ "$mode" != apply ] || mkdir -p "$dest" || return 1
        for entry in "$src"/* "$src"/.[!.]* "$src"/..?*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            merge_project_tree "$entry" "$dest/${entry##*/}" "$mode" || return 1
        done
    elif [ -f "$src" ]; then
        if [ -e "$dest" ]; then
            [ -f "$dest" ] && cmp -s "$src" "$dest" || {
                warn "  project conflict: $dest differs"; return 1;
            }
        elif [ "$mode" = apply ]; then
            cp -p "$src" "$dest" || return 1
        fi
    else
        warn "  unsupported project entry: $src"; return 1
    fi
)

restore_project() {
    [ "$_project" = 1 ] || return 0
    merge_project_tree "$_w/project" "$_local" check || return 2
    merge_project_tree "$_w/project" "$_local" apply || return 1
    say "  project files restored to $_local (existing identical files kept)"
}

cmd_push() {
    _host=; _to=; _sess=; _nohist=0; _recursive=0
    while [ $# -gt 0 ]; do
        case $1 in
            --session) need_value "$@"; _sess=$2; shift 2 ;;
            --transport) need_value "$@"; OPT_TRANSPORT=$2; shift 2 ;;
            --share) need_value "$@"; OPT_SHARE=$(abs_path "$2"); shift 2 ;;
            --no-history) _nohist=1; shift ;;
            -r) _recursive=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$_host" ] || die "expected one destination: ccsync push [-r] host:/remote-dir"
               _host=$1; shift ;;
        esac
    done

    case $_host in
        *:*)
            _address_path=${_host#*:}; _host=${_host%%:*}
            [ -n "$_host" ] && [ -n "$_address_path" ] || die "use host:/remote-dir or just host for a remembered destination"
            _to=$_address_path ;;
    esac

    _local=$(abs_path "$PWD")

    if [ -z "$_host" ]; then
        _n=0
        for h in $(map_hosts); do
            [ -n "$(map_remote_for "$h" "$_local")" ] && { _host=$h; _n=$((_n + 1)); }
        done
        [ "$_n" = 1 ] || die "name the destination: ccsync push host:/remote-dir"
    fi

    [ -z "$OPT_SHARE" ] || OPT_TRANSPORT=${OPT_TRANSPORT:-filesystem}
    [ -z "$OPT_SHARE" ] || [ "$OPT_TRANSPORT" = filesystem ] || die "--share requires filesystem transport"
    select_transport "$_host" || return 1

    if [ -n "$_to" ]; then
        _to=$(normalize_path "$_to")
        map_set path "$_hn" "$_local" "$_to"
        _remote=$_to
    else
        _remote=$(map_remote_for "$_hn" "$_local")
        [ -n "$_remote" ] || die "no directory mapped for $_local on $_hn. Use $_hn:/remote-dir (recorded for next time)."
    fi

    if [ "$TRANSPORT" = tailscale ] && [ "$(peer_field "$_hn" state)" != online ]; then
        die "$_hn is offline. Taildrop delivers directly and does not queue; bring the peer online and re-run."
    fi

    if [ -n "$_sess" ]; then
        case $_sess in
            */*) _src=$_sess ;;
            *) _src=$(project_dir "$_local")/$_sess.jsonl ;;
        esac
    else
        _src=$(newest_session "$_local") || die "no sessions recorded for $_local"
    fi
    [ -f "$_src" ] || die "session file not found: $_src"

    _sid=$(session_id_of "$_src")
    safe_component "$_sid" || die "unusable session id: $_sid"
    _lines=$(wc -l < "$_src" | tr -d ' ')
    _sha=$(sha256_of "$_src")
    _branch=$(command -v git >/dev/null 2>&1 && git -C "$_local" rev-parse --abbrev-ref HEAD 2>/dev/null)
    _cv=$(claude --version 2>/dev/null | awk '{print $1; exit}')

    _tmp=$(mktemp -d) || die "mktemp failed"
    if [ "$_recursive" = 1 ]; then
        if ! stage_project_path "$_local" "$_tmp/project" .; then
            rm -rf "$_tmp"
            die "could not copy project: symlinks, special files and unsupported filenames are not allowed"
        fi
    fi
    {
        mf_put kind session
        [ "$_recursive" = 0 ] || mf_put project_files 1
        mf_put tool_version "$VERSION"
        mf_put created_at "$(now_iso)"
        mf_put origin_host "$(self_host)"
        mf_put origin_cwd "$(transcript_cwd "$_local")"
        mf_put target_cwd "$_remote"
        mf_put session_id "$_sid"
        mf_put line_count "$_lines"
        mf_put sha256 "$_sha"
        mf_put git_branch "${_branch:-}"
        mf_put claude_version "${_cv:-}"
        mf_put first_prompt "$(first_prompt "$_src")"
    } > "$_tmp/manifest"
    cp "$_src" "$_tmp/$_sid.jsonl"

    _hist=0
    if [ "$_nohist" = 0 ] && [ -d "$FILE_HISTORY/$_sid" ]; then
        _kb=$(du -sk "$FILE_HISTORY/$_sid" 2>/dev/null | awk '{print $1}')
        if [ -n "$_kb" ] && [ "$_kb" -le "$MAX_HISTORY_KB" ]; then
            mkdir -p "$_tmp/file-history"
            cp -R "$FILE_HISTORY/$_sid" "$_tmp/file-history/$_sid"
            _hist=1
        else
            warn "  note: skipping file-history (${_kb}KB over cap)"
        fi
    fi
    printf 'file_history\t%s\n' "$_hist" >> "$_tmp/manifest"

    _uk=$(du -sk "$_tmp" | awk '{print $1}')
    [ "$_uk" -le "$MAX_UNPACKED_KB" ] || {
        rm -rf "$_tmp"; die "bundle exceeds the ${MAX_UNPACKED_KB} KB unpacked limit; reduce the project size or omit -r"
    }

    _stg=$(staging_dir)
    _b=$_stg/sess_${_sid}_$(self_host)_$(date '+%s')_$$.tar.gz
    ( cd "$_tmp" && tar -czf "$(archive_path "$_b")" . ) || die "could not build bundle"
    rm -rf "$_tmp"
    _kb=$(du -k "$_b" | awk '{print $1}')
    [ "$_kb" -le "$MAX_BUNDLE_KB" ] || {
        rm -f "$_b"; die "bundle exceeds the ${MAX_BUNDLE_KB} KB transfer limit; reduce the project size or omit -r"
    }
    if ! _err=$(send_bundle "$_b" "$_hn" 2>&1); then
        rm -f "$_b"; die "$TRANSPORT transfer to $_hn failed: $_err"
    fi
    rm -f "$_b"
    remember_transport "$_hn"
    say "pushed $_sid ($_lines lines, ${_kb} KB) -> $_hn:$_remote"
    [ "$_recursive" = 0 ] || say "  includes project files (receiver must run a version supporting project transfer)"
    say "  on $_hn: ccsync pull   then   claude --resume $_sid"
}

cmd_pull() {
    _into=; _source=; _force=0; _all=0
    while [ $# -gt 0 ]; do
        case $1 in
            --source) need_value "$@"; _source=$(abs_path "$2"); shift 2 ;;
            --force) _force=1; shift ;;
            --rewrite-all) _all=1; shift ;;
            --quiet) QUIET=1; shift ;;
            --auto) AUTO=1; QUIET=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$_into" ] && [ -n "$1" ] || die "expected one local destination: ccsync pull [local-dir]"
               _into=$1; shift ;;
        esac
    done
    case $_into in
        [A-Za-z]:/*|[A-Za-z]:\\*|/*|./*|../*) ;;
        *:*) die "pull accepts a local directory, not a remote source; run push on the sending machine first" ;;
    esac
    [ -z "$_into" ] || _into=$(abs_path "$_into")
    private_dir "$STATE"; private_dir "$ARCHIVE"
    if [ -n "$_source" ]; then
        [ -d "$_source" ] || die "source directory unavailable: $_source"
        import_inbox "$_source"
        return $?
    fi
    case $TRANSPORT in tailscale|filesystem) ;; *) die "unknown transport: $TRANSPORT" ;; esac
    # Each route runs separately: failures and probe replies must not change the
    # context of another inbox, and paths with spaces remain single records.
    _routes=$(receive_routes)
    [ -n "$_routes" ] || die "no receiving transports configured; run ccsync setup --share <dir> --host <name> or ccsync setup --transport tailscale"
    _pull_failed=0
    while IFS="$(printf '\t')" read -r route root; do
        [ -n "$route" ] || continue
        (TRANSPORT=$route; SHARE=$root; RECEIVE_ROUTE=1; pull_transport) || _pull_failed=1
    done <<EOF_ROUTES
$_routes
EOF_ROUTES
    [ "$AUTO" = 1 ] && return 0
    return "$_pull_failed"
}

pull_transport() {
    # Missing mounts or a stopped daemon must not emit hook errors every time
    # Claude Code starts, nor keep another configured route from being drained.
    if ! _ready_error=$(transport_ready 2>&1); then
        [ "$AUTO" = 1 ] || warn "$_ready_error"
        return 1
    fi
    if [ "$TRANSPORT" = filesystem ]; then
        if ! _ready_error=$(register_inbox 2>&1); then
            [ "$AUTO" = 1 ] || warn "$_ready_error"
            return 1
        fi
        import_inbox "$SHARE/$FS_HOST"
    else
        _stg=$(staging_dir)
        _fetch_failed=0
        _err=$(ts file get --conflict=rename "$(arg_path "$_stg")" 2>&1) || {
            [ "$AUTO" = 1 ] || warn "ccsync: Taildrop receive failed: ${_err:-unknown error}; check tailscale status"
            _fetch_failed=1
        }
        import_inbox "$_stg"
        auto_accept_dirs | while IFS= read -r d; do
            [ "$d" = "$_stg" ] || import_inbox "$d"
        done
        return "$_fetch_failed"
    fi
}

import_inbox() (
    _stg=$1
    _list=$(list_bundles "$_stg")
    [ -n "$_list" ] || { say "nothing waiting in $_stg"; return 0; }
    _deferred=0; _conflicted=0
    printf '%s\n' "$_list" | while IFS= read -r b; do
        [ -n "$b" ] || continue
        _kb=$(du -k "$b" 2>/dev/null | awk '{print $1; exit}')
        if [ -n "$_kb" ] && [ "$_kb" -gt "$MAX_BUNDLE_KB" ]; then
            warn "  reject $(basename "$b"): ${_kb} KB, over the ${MAX_BUNDLE_KB} KB limit"
            reject_bundle "$b"; continue
        fi
        _w=$(mktemp -d) || die "mktemp failed"
        # Check paths and entry types before extraction: project payloads must
        # not introduce traversal, symbolic links, hard links or devices.
        if ! tar -tzf "$(archive_path "$b")" > "$_w/.members" 2>/dev/null ||
           ! awk '/^\// || /\\/ || /^[A-Za-z]:/ { bad=1 }
                  { n=split($0,a,"/"); for(i=1;i<=n;i++) if(a[i]=="..") bad=1 }
                  END { exit bad }' "$_w/.members" ||
           ! tar -tvzf "$(archive_path "$b")" > "$_w/.types" 2>/dev/null ||
           ! awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" { bad=1 }
                  END { exit bad }' "$_w/.types"; then
            warn "  reject $(basename "$b"): unsafe archive paths or unsupported entry types"
            rm -rf "$_w"; reject_bundle "$b"; continue
        fi
        if ! tar -xzf "$(archive_path "$b")" -C "$_w" 2>/dev/null; then
            warn "  reject $(basename "$b"): not a readable bundle"
            rm -rf "$_w"; reject_bundle "$b"; continue
        fi
        _uk=$(du -sk "$_w" 2>/dev/null | awk '{print $1; exit}')
        if [ -n "$_uk" ] && [ "$_uk" -gt "$MAX_UNPACKED_KB" ]; then
            warn "  reject $(basename "$b"): expands to ${_uk} KB, over the ${MAX_UNPACKED_KB} KB limit"
            rm -rf "$_w"; reject_bundle "$b"; continue
        fi
        [ -f "$_w/manifest" ] || {
            warn "  reject $(basename "$b"): no manifest"
            rm -rf "$_w"; reject_bundle "$b"; continue
        }
        _kind=$(mf_get "$_w/manifest" kind)
        _ok=0
        case $_kind in
            probe)   handle_probe "$_w/manifest" && _ok=1 ;;
            ack)     handle_ack "$_w/manifest" && _ok=1 ;;
            session) handle_session "$_w/manifest" "$_w" "$_into" "$_force" "$_all"
                     case $? in
                         0) _ok=1 ;;
                         2) _ok=2 ;;
                     esac ;;
            *) warn "  reject $(basename "$b"): unknown bundle kind '$_kind'"; _ok=3 ;;
        esac
        rm -rf "$_w"
        case $_ok in
            1) mv "$b" "$ARCHIVE/" 2>/dev/null || rm -f "$b" ;;
            2) private_dir "$CONFLICTS"
               mv "$b" "$CONFLICTS/" 2>/dev/null
               warn "        set aside in $CONFLICTS (it will not be retried)" ;;
            3) reject_bundle "$b" ;;
            *) say "  left queued in $_stg" ;;
        esac
    done
    return 0
)

# A bundle we will never be able to read. Move it out of the inbox so the
# SessionStart hook does not retry it on every session for the rest of time.
reject_bundle() { # path
    private_dir "$CONFLICTS"
    mv "$1" "$CONFLICTS/" 2>/dev/null || rm -f "$1"
    warn "        set aside in $CONFLICTS (it will not be retried)"
}

list_bundles() {
    [ -d "$1" ] || return 0
    for f in "$1"/sess_*.tar.gz "$1"/probe_*.tar.gz "$1"/ack_*.tar.gz; do
        [ -f "$f" ] && printf '%s\n' "$f"
    done | sort
}

handle_probe() (
    _mf=$1
    _origin=$(mf_get "$_mf" origin_host)
    _claimed=$(abs_path "$(mf_get "$_mf" claimed_remote_cwd)")
    _theirs=$(mf_get "$_mf" origin_cwd)
    safe_component "$_origin" || { warn "  skip probe: unusable origin host"; return 1; }
    _exists=no; [ -d "$_claimed" ] && _exists=yes

    remember_received_transport "$_origin"
    map_set path "$_origin" "$_claimed" "$_theirs"
    map_set host "$_origin" verified "$(now_iso)"

    say "probe from $_origin"
    say "  $_origin:$_theirs  <->  $_claimed  ($( [ "$_exists" = yes ] && echo exists || echo 'MISSING on this machine'))"

    if [ "$RECEIVE_ROUTE" != 1 ]; then
        _local=$_claimed
        if ! select_transport "$_origin"; then
            say "  reverse mapping saved; ack not sent (configure a return transport with init)"
            return 0
        fi
    fi
    if [ "$TRANSPORT" = filesystem ] || [ "$(peer_field "$_origin" state)" = online ]; then
        _stg=$(staging_dir)
        _t=$(mktemp -d) || { warn "  cannot stage acknowledgement"; return 1; }
        {
            mf_put kind ack
            mf_put requested_host "$(mf_get "$_mf" target_host)"
            mf_put probe_id "$(mf_get "$_mf" probe_id)"
            mf_put tool_version "$VERSION"
            mf_put created_at "$(now_iso)"
            mf_put origin_host "$(self_host)"
            mf_put origin_cwd "$_claimed"
            mf_put peer_cwd "$_theirs"
            mf_put path_exists "$_exists"
            mf_put claude_version "$(claude --version 2>/dev/null | awk '{print $1; exit}')"
        } > "$_t/manifest"
        _b=$_stg/ack_$(self_host)_$(date '+%s')_$$.tar.gz
        ( cd "$_t" && tar -czf "$(archive_path "$_b")" manifest ) || {
            rm -rf "$_t"; rm -f "$_b"; warn "  could not build acknowledgement"; return 1;
        }
        rm -rf "$_t"
        if _err=$(send_bundle "$_b" "$_origin" 2>&1); then
            say "  ack sent -> $_origin"
        else
            [ "$AUTO" = 1 ] || warn "  $TRANSPORT acknowledgement to $_origin failed: $_err; re-run init to retry verification"
        fi
        rm -f "$_b"
    else
        say "  $_origin offline; ack not sent"
    fi
    [ "$_exists" = yes ] || say "  fix: create $_claimed here, or re-run init on $_origin with the right path"
    return 0
)

handle_ack() (
    _mf=$1
    _host=$(mf_get "$_mf" origin_host)
    safe_component "$_host" || { warn "  skip ack: unusable origin host"; return 1; }
    _requested=$(mf_get "$_mf" requested_host)
    _probe=$(mf_get "$_mf" probe_id)
    if [ -n "$_requested$_probe" ]; then
        safe_component "$_requested" && safe_component "$_probe" || { warn "  skip ack: invalid probe identity"; return 1; }
        [ "$(map_get host "$_requested" probe_id)" = "$_probe" ] || {
            say "  ignored old or unsolicited acknowledgement from $_host"; return 0;
        }
        if [ "$_requested" != "$_host" ]; then
            # Only a reply to our pending probe may correct an alias. Other
            # mappings on the confirmed host are retained.
            awk -F '\t' -v h="$_requested" '$1=="path" && $2==h {print $3 "\t" $4}' "$MAP" |
                while IFS="$(printf '\t')" read -r local_dir remote_dir; do
                    map_set path "$_host" "$local_dir" "$remote_dir"
                done
            for field in transport share os; do
                value=$(map_get host "$_requested" "$field")
                [ -z "$value" ] || map_set host "$_host" "$field" "$value"
            done
            map_del path "$_requested"
            map_del host "$_requested"
            say "  peer name confirmed: $_requested -> $_host (saved mappings updated)"
        fi
        map_del host "$_host" probe_id
    fi
    remember_received_transport "$_host"
    map_set host "$_host" verified "$(now_iso)"
    map_set host "$_host" path_exists "$(mf_get "$_mf" path_exists)"
    map_set host "$_host" claude_version "$(mf_get "$_mf" claude_version)"
    if [ "$(mf_get "$_mf" path_exists)" = yes ]; then _m=OK; else _m="PATH MISSING"; fi
    say "ack from $_host: $_m  ($(mf_get "$_mf" peer_cwd) <-> $(mf_get "$_mf" origin_cwd))"
    say "  remote Claude Code: $(mf_get "$_mf" claude_version)"
    return 0
)

handle_session() (
    _mf=$1; _w=$2; _into=$3; _force=$4; _all=$5
    _sid=$(mf_get "$_mf" session_id)
    _origin=$(mf_get "$_mf" origin_host)
    _ocwd=$(mf_get "$_mf" origin_cwd)
    _target=$(mf_get "$_mf" target_cwd)
    _project=$(mf_get "$_mf" project_files)
    case $_project in ''|0|1) ;; *) warn "  skip bundle: unknown project payload format"; return 2 ;; esac
    if [ "$_project" = 1 ] && [ ! -d "$_w/project" ]; then
        warn "  skip bundle: project payload missing"; return 2
    fi
    safe_component "$_sid" || { warn "  skip bundle: unusable session id"; return 1; }
    safe_component "$_origin" || { warn "  skip $_sid: unusable origin host"; return 1; }

    if [ -n "$_into" ]; then
        _local=$(abs_path "$_into")
    else
        _local=$(map_local_for "$_origin" "$_ocwd")
        if [ -z "$_local" ] && [ -n "$_target" ] && [ -d "$_target" ]; then
            _local=$(abs_path "$_target")
            map_set path "$_origin" "$_local" "$_ocwd"
            say "  mapped $_origin:$_ocwd -> $_local (as the sender specified)"
        fi
    fi
    [ -z "$_local" ] || _local=$(abs_path "$_local")
    if [ -z "$_local" ]; then
        [ "$QUIET" = 1 ] || {
            warn "  skip $_sid: no local directory for $_origin:$_ocwd"
            [ -n "$_target" ] && warn "        the sender mapped it to $_target, which does not exist here"
            warn "        place it with: ccsync pull <local-dir>"
        }
        return 1
    fi
    # Only an explicit local destination may create a new project directory.
    if [ ! -d "$_local" ]; then
        if [ -n "$_into" ] && [ "$_project" = 1 ] && [ ! -e "$_local" ] && [ ! -L "$_local" ]; then
            case $_local in /*|[A-Za-z]:*) ;; *) _local=$PWD/$_local ;; esac
        else
            [ "$QUIET" = 1 ] || warn "  skip $_sid: $_local is not a directory"; return 1
        fi
    fi

    _src=$_w/$_sid.jsonl
    [ -f "$_src" ] || { warn "  skip $_sid: bundle has no transcript"; return 1; }
    _want=$(mf_get "$_mf" sha256)
    if [ -n "$_want" ]; then
        _got=$(sha256_of "$_src")
        [ -z "$_got" ] || [ "$_got" = "$_want" ] || { warn "  skip $_sid: checksum mismatch"; return 1; }
    fi

    remember_received_transport "$_origin"
    _dd=$(project_dir "$_local")
    _dest=$_dd/$_sid.jsonl

    if [ -f "$_dest" ]; then
        _lt=$_w/.local_tokens; _it=$_w/.incoming_tokens
        chain "$_dest" "$(transcript_cwd "$_local")" > "$_lt"
        chain "$_src" "$_ocwd" > "$_it"
        _rel=$(compare_chains "$_lt" "$_it")
        case $_rel in
            same)
                restore_project || return $?
                map_set path "$_origin" "$_local" "$_ocwd"
                say "  up to date $_sid ($(wc -l < "$_lt" | tr -d ' ') entries)"
                return 0 ;;
            behind)
                [ "$_force" = 1 ] || {
                    say "  kept local $_sid: this machine is ahead ($(wc -l < "$_lt" | tr -d ' ') entries vs $(wc -l < "$_it" | tr -d ' ') incoming)"
                    return 0
                } ;;
            diverged)
                [ "$_force" = 1 ] || {
                    warn "  refused $_sid: diverged after $(common_prefix_len "$_lt" "$_it") entries (local $(wc -l < "$_lt" | tr -d ' '), incoming $(wc -l < "$_it" | tr -d ' ')). Both sides have work the other does not."
                    warn "        to take theirs: ccsync pull --source $CONFLICTS --force  (a .bak copy is kept)"
                    return 2
                } ;;
        esac
    fi

    restore_project || return $?
    if [ -f "$_dest" ]; then
        _bak=$_dest.bak-$(date '+%s'); _n=0
        while [ -e "$_bak" ]; do
            _n=$((_n + 1)); _bak=$_dest.bak-$(date '+%s')-$_n
        done
        cp "$_dest" "$_bak"
    fi

    mkdir -p "$_dd"
    # Build beside the destination and rename over it, so a failure part-way
    # through cannot leave a truncated transcript where a whole one was.
    _new=$_dd/.$_sid.jsonl.new.$$
    _counts=$(rewrite_jsonl "$_src" "$_new" "$_ocwd" "$(transcript_cwd "$_local")" "$_all") || {
        rm -f "$_new"; warn "  skip $_sid: could not write transcript"; return 1
    }
    mv "$_new" "$_dest" || { rm -f "$_new"; warn "  skip $_sid: could not place transcript"; return 1; }
    map_set path "$_origin" "$_local" "$_ocwd"
    set -- $_counts
    _lines=${1:-0}; _changed=${2:-0}

    if [ "$(mf_get "$_mf" file_history)" = 1 ] && [ -d "$_w/file-history/$_sid" ]; then
        # cp -R keeps symlinks as symlinks; one pointing out of the tree would
        # become a live path Claude later writes through.
        if [ -h "$_w/file-history/$_sid" ] ||
           [ -n "$(find "$_w/file-history/$_sid" -type l -print 2>/dev/null | head -n 1)" ]; then
            warn "  $_sid: file history not restored, the bundle contains symlinks"
        else
            rm -rf "$FILE_HISTORY/$_sid"
            mkdir -p "$FILE_HISTORY"
            cp -R "$_w/file-history/$_sid" "$FILE_HISTORY/$_sid"
        fi
    fi

    printf 'pulled %s from %s\n' "$_sid" "$_origin"
    printf '  %s lines, %s cwd rewrites: %s -> %s\n' "$_lines" "$_changed" "$_ocwd" "$_local"
    _fp=$(mf_get "$_mf" first_prompt); [ -n "$_fp" ] && printf '  "%s"\n' "$_fp"
    _tv=$(mf_get "$_mf" claude_version)
    _mv=$(claude --version 2>/dev/null | awk '{print $1; exit}')
    [ -n "$_tv" ] && [ -n "$_mv" ] && [ "$_tv" != "$_mv" ] && \
        printf '  note: Claude Code %s (origin) vs %s (here)\n' "$_tv" "$_mv"
    printf '  resume:  cd %s && claude --resume %s\n' "$_local" "$_sid"
    return 0
)

cmd_list() {
    _limit=20
    while [ $# -gt 0 ]; do
        case $1 in
            --limit) need_value "$@"; _limit=$2; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    _cwd=$(abs_path "$PWD")
    _d=$(project_dir "$_cwd")
    [ -d "$_d" ] || { say "no sessions for $_cwd"; return 0; }
    say "$_cwd  ($(basename "$_d"))"
    _n=0
    ls -t "$_d"/*.jsonl 2>/dev/null | while IFS= read -r f; do
        _n=$((_n + 1)); [ "$_n" -gt "$_limit" ] && break
        printf '  %s  %s  %5s lines  %s\n' \
            "$(session_id_of "$f")" \
            "$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null || stat -c '%y' "$f" | cut -c1-16)" \
            "$(wc -l < "$f" | tr -d ' ')" \
            "$(first_prompt "$f")"
    done
}

bundle_count() { list_bundles "$1" | awk 'END {print NR+0}'; }

cmd_status() {
    [ "$#" = 0 ] || die "status takes no arguments"
    case $TRANSPORT in tailscale|filesystem) ;; *) die "unknown transport: $TRANSPORT" ;; esac
    if [ "$TRANSPORT" = filesystem ] || [ -n "$(configured_shares)" ]; then
        safe_component "$FS_HOST" || die "configure an endpoint name: ccsync setup --share <dir> --host <name>"
    fi
    _cwd=$(abs_path "$PWD")
    say "ccsync $VERSION   default transport: $TRANSPORT"
    if [ -f "$MAP" ]; then say "configuration: $MAP"; else say "configuration: built-in defaults (no saved setup)"; fi
    [ -z "${CCSYNC_TRANSPORT:-}" ] || say "environment override: CCSYNC_TRANSPORT=$CCSYNC_TRANSPORT"
    [ -z "${CCSYNC_SHARE:-}" ] || say "environment override: CCSYNC_SHARE=$CCSYNC_SHARE"
    [ -z "${CCSYNC_HOST:-}" ] || say "environment override: CCSYNC_HOST=$CCSYNC_HOST"
    say "cwd: $_cwd"
    say "transports and inboxes:"
    receive_routes | while IFS="$(printf '\t')" read -r route root; do
        (
            TRANSPORT=$route; SHARE=$root
            if [ "$route" = filesystem ]; then
                say "  filesystem: $root   self: $FS_HOST"
                if [ ! -d "$root" ]; then
                    say "    unavailable; mount the share or correct it with ccsync setup --share <dir>"
                else
                    say "    inbox: $(bundle_count "$root/$FS_HOST") waiting for $FS_HOST"
                    _peers=$(filesystem_peers)
                    if [ -z "$_peers" ]; then
                        say "    no registered endpoints; run ccsync setup on both endpoints"
                    else
                        for name in $_peers; do
                            [ "$name" != "$FS_HOST" ] || continue
                            say "    discovered: $name   $(bundle_count "$root/$name") waiting for import"
                        done
                    fi
                    if [ ! -d "$root/$FS_HOST" ]; then
                        say "    local inbox missing; run ccsync setup --share <dir> --host $FS_HOST"
                    elif [ ! -w "$root/$FS_HOST" ]; then
                        say "    local inbox is not writable; check share permissions"
                    fi
                fi
            elif _error=$(transport_ready 2>&1); then
                find_tailscale
                if _tail_status=$(ts status 2>&1); then
                    ts_status_cache=$_tail_status
                    say "  tailscale: $TS_BIN   self: $(self_host)"
                    say "    pending Taildrop delivery: managed by Tailscale; run ccsync pull to fetch"
                    ts_status | awk -v self="$(self_host)" '
                        NF>=2 && $1 ~ /^[0-9]+\./ && $2!=self {
                            state="online"; for(i=3;i<=NF;i++) if(tolower($i) ~ /^offline/) state="offline"
                            printf "    discovered: %s [%s] %s\n",$2,state,$1
                        }'
                    say "    local staging: $(bundle_count "$OUTBOX") bundles"
                else
                    say "  tailscale: unavailable; $_tail_status; check the Tailscale service"
                fi
            else
                say "  tailscale: unavailable; $_error"
            fi
        )
    done
    _hosts=$(map_hosts)
    if [ -z "$_hosts" ]; then
        say "no saved peers. Pair a discovered name: ccsync init <peer> <remote-dir>"
        return 0
    fi
    say "saved peers (push uses flags > environment > saved peer > default):"
    for h in $_hosts; do
        (
            TRANSPORT=${CCSYNC_TRANSPORT:-$(map_get host "$h" transport)}
            TRANSPORT=${TRANSPORT:-tailscale}
            SHARE=${CCSYNC_SHARE:-$(map_get host "$h" share)}
            SHARE=${SHARE:-$DEFAULT_SHARE}
            _v=$(map_get host "$h" verified); [ -n "$_v" ] || _v=unverified
            if [ "$TRANSPORT" = filesystem ]; then
                _state=unavailable; [ ! -d "$SHARE/$h" ] || _state='inbox available'
                say "  $h [$TRANSPORT, $_state] share: $SHARE; verified: $_v"
            else
                say "  $h [tailscale] verified: $_v"
            fi
            [ "$(map_get host "$h" path_exists)" != no ] || say "    destination path missing on receiver; correct init's remote directory"
            CCSYNC_PATH_WINDOWS=$IS_WINDOWS CCSYNC_LOOKUP_PATH=$_cwd awk -F '\t' -v h="$h" "$PATH_AWK"'
                $1=="path" && $2==h {
                    printf "   %s %s -> %s\n", (pathkey($3,1)==pathkey(ENVIRON["CCSYNC_LOOKUP_PATH"],1)?"*":" "),$3,$4
                }' "$MAP"
        )
    done
    say "filesystem availability means the inbox exists, not that the receiver is running"
}

# --------------------------------------------------------------------- main

[ $# -gt 0 ] || { usage; exit 1; }
_cmd=$1; shift
load_config
case $_cmd in
    setup)  cmd_setup "$@" ;;
    init)   cmd_init "$@" ;;
    unmap)  cmd_unmap "$@" ;;
    push)   cmd_push "$@" ;;
    pull)   cmd_pull "$@" ;;
    list)   cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    --version|-v) printf '%s\n' "$VERSION" ;;
    --help|-h|help) usage ;;
    *) usage; exit 1 ;;
esac
